{
  "name": "daalbhat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "firebase:emulate": "npx -y firebase-tools@latest emulators:start",
    "firebase:deploy": "npm run build && npx -y firebase-tools@latest deploy --only hosting,firestore:rules,storage --project daalbhat-grocery",
    "firebase:deploy:all": "npm run build && npx -y firebase-tools@latest deploy --project daalbhat-grocery",
    "db:seed-firestore": "node scripts/seedFirestore.js",
    "db:backup": "node scripts/backupFirestore.js",
    "db:clean-products": "node scripts/cleanProducts.js"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "dotenv": "^16.4.7",
    "firebase": "^11.4.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1"
  }
}
