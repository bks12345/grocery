rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource != null &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)');
    }

    function isValidSize() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 15 * 1024 * 1024;
    }

    function isValidFileName(name) {
      return name.size() > 0 && name.size() <= 128;
    }

    // Product Images: Public read, authenticated validated uploads, authenticated delete
    match /products/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImage() && isValidSize() && isValidFileName(fileName);
      allow delete: if isAuthenticated();
    }
    match /products/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImage() && isValidSize() && isValidFileName(fileName);
      allow delete: if isAuthenticated();
    }

    // Goat Cut Photos: Public read, authenticated validated uploads, authenticated delete
    match /goat/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImage() && isValidSize() && isValidFileName(fileName);
      allow delete: if isAuthenticated();
    }
    match /goat/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImage() && isValidSize() && isValidFileName(fileName);
      allow delete: if isAuthenticated();
    }

    // CMS & Banner Graphics: Public read, authenticated validated uploads, authenticated delete
    match /cms/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImage() && isValidSize() && isValidFileName(fileName);
      allow delete: if isAuthenticated();
    }
    match /cms/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImage() && isValidSize() && isValidFileName(fileName);
      allow delete: if isAuthenticated();
    }

    // Category Graphics: Public read, authenticated validated uploads, authenticated delete
    match /categories/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImage() && isValidSize() && isValidFileName(fileName);
      allow delete: if isAuthenticated();
    }

    // General App Media Uploads: Public read, authenticated validated uploads, authenticated delete
    match /uploads/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImage() && isValidSize() && isValidFileName(fileName);
      allow delete: if isAuthenticated();
    }
    match /uploads/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImage() && isValidSize() && isValidFileName(fileName);
      allow delete: if isAuthenticated();
    }

    // Absolute Default Deny: Disallow reading or writing to any unexpected bucket paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
